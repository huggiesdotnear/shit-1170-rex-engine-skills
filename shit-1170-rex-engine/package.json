{
  "name": "@huggies/shit-1170-rex-engine-skill",
  "version": "0.1.0",
  "description": "Agent toolkit for proposing, queuing, and tracking shit-1170 rex engine transactions and swaps",
  "license": "MIT",
  "homepage": "https://shit-1170.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/huggiesdotnear/shit-1170-rex-engine-skills.git",
    "directory": "shit-1170-rex-engine"
  },
  "type": "module",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "DOCS/**/*",
    "src/**/*",
    "bin/**/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -f .tsbuildinfo && bun run tsc --build tsconfig.build.json --force",
    "clean": "bun run tsc --build --clean && rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@huggies/shit-1170-rex-engine-middleman": "^0.0.2",
    "@near-kit-tool-box/env": "0.3.0",
    "@near-kit-tool-box/fun": "0.3.0",
    "@sleet-js/middleman-intear-api": "^0.1.0",
    "near-kit": "^0.20.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
