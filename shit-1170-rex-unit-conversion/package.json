{
  "name": "@huggies/shit-1170-rex-unit-conversion",
  "version": "0.1.0",
  "description": "agent friendly unit conversion for near tokens: human decimals to chain units and back",
  "license": "MIT",
  "homepage": "https://shit-1170.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/huggiesdotnear/shit-1170-rex-engine-skills.git",
    "directory": "shit-1170-rex-unit-conversion"
  },
  "type": "module",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "src/**/*",
    "bin/**/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -f tsconfig.build.tsbuildinfo && bun run tsc --build tsconfig.build.json --force",
    "clean": "bun run tsc --build --clean && rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@sleet-js/middleman-intear-api": "^0.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
